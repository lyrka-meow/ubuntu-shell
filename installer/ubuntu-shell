#!/usr/bin/env bash
set -Eeuo pipefail

INSTALL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/ubuntu-shell"

if ! docker info >/dev/null 2>&1; then
  echo "Docker is unavailable. Log out and back in, then try again." >&2
  exit 1
fi

if ! docker compose -f "$INSTALL_DIR/compose.yaml" ps --status running --quiet |
  grep -q .; then
  if ! start_output="$(
    docker compose -f "$INSTALL_DIR/compose.yaml" up -d 2>&1
  )"; then
    echo "$start_output" >&2
    exit 1
  fi
fi

exec docker compose -f "$INSTALL_DIR/compose.yaml" exec ubuntu bash
