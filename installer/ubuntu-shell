#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SOURCE_INSTALL_DIR="$(dirname -- "$(dirname -- "$SCRIPT_PATH")")"
SYSTEM_INSTALL_DIR="/usr/share/ubuntu-shell"

if [[ -f "$SOURCE_INSTALL_DIR/compose.yaml" &&
      -f "$SOURCE_INSTALL_DIR/Dockerfile" ]]; then
  INSTALL_DIR="$SOURCE_INSTALL_DIR"
else
  INSTALL_DIR="$SYSTEM_INSTALL_DIR"
fi

DOCKER=(docker)
COMPOSE=()

usage() {
  cat <<'EOF'
Usage: ubuntu-shell [command]

Commands:
  shell     Start the container and open the Ubuntu shell (default)
  start     Start or update the container without opening a shell
  status    Show the container status
  stop      Stop and remove the container, preserving the home volume
  clean     Remove the container, image and persistent home volume
  help      Show this help
EOF
}

require_installation() {
  if [[ ! -r "$INSTALL_DIR/compose.yaml" ||
        ! -r "$INSTALL_DIR/Dockerfile" ]]; then
    echo "Ubuntu Shell installation is incomplete: $INSTALL_DIR" >&2
    exit 1
  fi
}

require_docker() {
  local current_user

  if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is not installed." >&2
    exit 1
  fi

  if ! docker compose version >/dev/null 2>&1; then
    echo "The Docker Compose plugin is not installed." >&2
    exit 1
  fi

  if docker info >/dev/null 2>&1; then
    return
  fi

  if [[ -n "${DOCKER_HOST:-}" ]]; then
    echo "Cannot connect to the configured Docker host." >&2
    exit 1
  fi

  if ! command -v sudo >/dev/null 2>&1; then
    echo "Docker setup requires sudo." >&2
    exit 1
  fi

  echo "Ubuntu Shell needs one-time Docker setup." >&2

  if ! systemctl is-active --quiet docker.service ||
    ! systemctl is-enabled --quiet docker.service; then
    if ! sudo systemctl enable --now docker.service; then
      echo "Could not start Docker." >&2
      exit 1
    fi
  fi

  if docker info >/dev/null 2>&1; then
    return
  fi

  current_user="$(id -un)"
  if [[ "$(id -u)" -ne 0 ]] &&
    ! id -nG "$current_user" | tr ' ' '\n' | grep -qx docker; then
    if ! sudo usermod -aG docker "$current_user"; then
      echo "Could not grant Docker access to $current_user." >&2
      exit 1
    fi
    echo "Docker access was enabled for $current_user." >&2
  fi

  if [[ "$(id -u)" -ne 0 ]] && sudo docker info >/dev/null 2>&1; then
    DOCKER=(sudo docker)
    echo "Using sudo for this session; later logins will not need it." >&2
    return
  fi

  echo "Docker is still unavailable after setup." >&2
  exit 1
}

start_container() {
  local start_output

  if ! start_output="$("${COMPOSE[@]}" up -d --build 2>&1)"; then
    echo "$start_output" >&2
    exit 1
  fi
}

case "${1:-shell}" in
  help|-h|--help)
    usage
    exit 0
    ;;
  shell|start|status|stop|clean)
    command_name="${1:-shell}"
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac

require_installation
require_docker
COMPOSE=(
  "${DOCKER[@]}" compose
  --project-name ubuntu-shell
  --file "$INSTALL_DIR/compose.yaml"
)

case "$command_name" in
  shell)
    start_container
    exec "${COMPOSE[@]}" exec ubuntu bash
    ;;
  start)
    start_container
    ;;
  status)
    exec "${COMPOSE[@]}" ps
    ;;
  stop)
    exec "${COMPOSE[@]}" down
    ;;
  clean)
    exec "${COMPOSE[@]}" down --volumes --rmi local
    ;;
esac
